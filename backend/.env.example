# .env.example
# Copy this to .env and update the values

# Server Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/dacras_db
MONGODB_TEST_URI=mongodb://localhost:27017/dacras_test

# Redis Configuration (for job queues and caching)
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# AI Service Configuration
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TEXEL_AI_API_KEY=your_texel_ai_api_key_here
TEXEL_AI_BASE_URL=https://api.prod.texel.ai

# AWS S3 Configuration (for file storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=dacras-video-storage
S3_BUCKET_URL=https://dacras-video-storage.s3.amazonaws.com

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@dacras.ai
FROM_NAME=Dacras AI

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_key
ALLOWED_WEBHOOK_IPS=127.0.0.1,::1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE=104857600
MAX_FILES_PER_REQUEST=10
ALLOWED_FILE_TYPES=mp4,mov,avi,jpg,jpeg,png,gif,wav,mp3

# Processing Configuration
MAX_CONCURRENT_JOBS=10
JOB_TIMEOUT_MS=300000
CLEANUP_INTERVAL_MS=3600000

# External APIs
REPLICATE_API_TOKEN=your_replicate_token
RUNWAY_API_KEY=your_runway_api_key
ELEVEN_LABS_API_KEY=your_eleven_labs_key

# Monitoring & Analytics
SENTRY_DSN=your_sentry_dsn_here
GOOGLE_ANALYTICS_ID=your_ga_id
MIXPANEL_TOKEN=your_mixpanel_token

# Development
DEBUG=dacras:*
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true

# Production overrides (uncomment for production)
# NODE_ENV=production
# LOG_LEVEL=info
# ENABLE_REQUEST_LOGGING=false
# DEBUG=